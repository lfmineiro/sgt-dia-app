# Copie este arquivo para .env e preencha com valores reais antes do deploy.
# cp .env.production.example .env && nano .env

# =====================================================
# Postgres (interno — db NÃO é exposto fora do compose)
# =====================================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=trocar_em_producao
POSTGRES_DB=sped_db

# =====================================================
# Backend
# =====================================================

# JWT — usar string aleatória longa. Ex.: openssl rand -hex 32
JWT_SECRET=gerar_string_aleatoria_64_chars
JWT_EXPIRES_IN=1d

# Login fixo da aplicação (única conta)
AUTH_LOGIN_USER=login
AUTH_LOGIN_PASSWORD=senha_de_producao

# Cloudinary — obrigatório para upload de fotos das alterações
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sgt_dia_alteracoes

# =====================================================
# Frontend (build-time — embutido no bundle pelo Vite)
# =====================================================
# IP do servidor compartilhado (Grupo 1) — porta 8002 é onde o backend é exposto.
# Se o IP do servidor mudar, atualize aqui e rode: DEPLOY_NOCACHE=1 ./scripts/deploy.sh
VITE_API_URL=http://192.168.91.176:8002/api
